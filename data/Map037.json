{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":102,"indent":0,"parameters":[["Sir Wiliams X - Capitulo 2","No"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Sir Wiliams X - Capitulo 2"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["\\{Capítulo II – La Torre de Piedra Negra\\}"]},{"code":401,"indent":1,"parameters":["No hay mapas que mencionen la Torre de Piedra Negra. "]},{"code":401,"indent":1,"parameters":["No porque sea un secreto, sino porque nadie quiere "]},{"code":401,"indent":1,"parameters":["recordarla."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Se alza en el corazón de una región sin nombre, donde "]},{"code":401,"indent":1,"parameters":["las lluvias no cesan y la tierra no da fruto. Allí van los que "]},{"code":401,"indent":1,"parameters":["el Reino no puede ejecutar pero tampoco permitir que "]},{"code":401,"indent":1,"parameters":["vivan libres. Ladrones, desertores, nobles caídos en "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["desgracia, y, a veces, niños."]},{"code":401,"indent":1,"parameters":["William fue uno de esos niños."]},{"code":401,"indent":1,"parameters":["Llegó encadenado a los siete inviernos, sin más "]},{"code":401,"indent":1,"parameters":["pertenencias que un collar con la insignia borrada de "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["una casa extinta. Nadie lo reclamó. Nadie preguntó por "]},{"code":401,"indent":1,"parameters":["él. Solo el capataz de la torre, un hombre sin lengua, lo "]},{"code":401,"indent":1,"parameters":["arrastró al nivel más bajo y lo arrojó junto a los otros "]},{"code":401,"indent":1,"parameters":["pequeños condenados."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Allí aprendió sus primeras lecciones: "]},{"code":401,"indent":1,"parameters":["La comida no se comparte. El frío no perdona. Y el "]},{"code":401,"indent":1,"parameters":["silencio es más seguro que la verdad."]},{"code":401,"indent":1,"parameters":["Los instructores eran carceleros. Las clases, castigos. Y "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["las tareas diarias no consistían en leer libros, sino en "]},{"code":401,"indent":1,"parameters":["enterrar a los que no sobrevivían. "]},{"code":401,"indent":1,"parameters":["Uno por uno, sus compañeros fueron cayendo. Algunos "]},{"code":401,"indent":1,"parameters":["por enfermedad. Otros por hambre. Algunos... "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["simplemente desaparecían."]},{"code":401,"indent":1,"parameters":["Pero William no. Él observaba.Aprendió a caminar sin ser "]},{"code":401,"indent":1,"parameters":["oído, a leer rostros con una mirada, a mentir sin hablar. "]},{"code":401,"indent":1,"parameters":["Cada día se volvía más invisible, más implacable."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["A los catorce, ya enseñaba a otros cómo sobrevivir. A los "]},{"code":401,"indent":1,"parameters":["dieciséis, le entregaron un cuchillo. A los diecisiete, le "]},{"code":401,"indent":1,"parameters":["ordenaron usarlo. No preguntó contra quién. No pidió "]},{"code":401,"indent":1,"parameters":["explicaciones."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Así fue como la Torre de Piedra Negra no lo quebró… lo "]},{"code":401,"indent":1,"parameters":["convirtió en un arma."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"No"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":3},
