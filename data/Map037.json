{"id":1,"name":"Libros IV","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":102,"indent":0,"parameters":[["Sir William X - Capitulo 1","Historia de la Madera","San Jones y la Travesia de la Fruta","Historia de la Mina Sombraluna","Nacimientos Oficiales","Cuentos para dormir de Altamar"],-2,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Sir William X - Capitulo 1"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["\\{Capítulo I — El Juramento de las Sombras\\}"]},{"code":401,"indent":1,"parameters":["Nadie recuerda el día en que nació Sir William X, pero todos "]},{"code":401,"indent":1,"parameters":["recuerdan el día en que juró por última vez."]},{"code":401,"indent":1,"parameters":["Fue al anochecer, bajo los estandartes roídos del Reino de "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Vareldor, cuando el joven William, aún sin cicatrices visibles, se "]},{"code":401,"indent":1,"parameters":["arrodilló ante el Alto Trono y dijo:"]},{"code":401,"indent":1,"parameters":["— “Prometo lealtad sin gloria, servicio sin honra, y muerte sin "]},{"code":401,"indent":1,"parameters":["canto.”"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Era un juramento oscuro, poco común incluso entre los "]},{"code":401,"indent":1,"parameters":["caballeros caídos. Pero Sir William X no era un hombre "]},{"code":401,"indent":1,"parameters":["ordinario. Criado en la Torre de Piedra Negra, bastardo de una "]},{"code":401,"indent":1,"parameters":["casa extinguida y aprendiz de un capitán ejecutado por "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["insubordinación, aprendió que los escudos no siempre "]},{"code":401,"indent":1,"parameters":["protegen, y que las promesas, como las espadas, pueden "]},{"code":401,"indent":1,"parameters":["usarse para herir."]},{"code":401,"indent":1,"parameters":["El Rey lo miró en silencio. No hubo aplausos. No hubo testigos "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["más allá del consejero sin rostro y dos perros de guerra. Solo "]},{"code":401,"indent":1,"parameters":["una marca quedó grabada en el mármol del salón: una X "]},{"code":401,"indent":1,"parameters":["profunda tallada con su propia daga."]},{"code":401,"indent":1,"parameters":["Desde ese día, William dejó atrás su apellido —si es que alguna "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["vez tuvo uno— y se convirtió en lo que el Reino necesitaba: un "]},{"code":401,"indent":1,"parameters":["lobo que caza en silencio, que muerde sin ladrar, y que nunca "]},{"code":401,"indent":1,"parameters":["pregunta por qué."]},{"code":401,"indent":1,"parameters":["Años después, en cada rincón del reino, los campesinos "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["hablarían de un jinete de capa gris, que no hablaba y que "]},{"code":401,"indent":1,"parameters":["aparecía cuando las reglas eran rotas… o cuando los secretos "]},{"code":401,"indent":1,"parameters":["amenazaban con salir a la luz."]},{"code":401,"indent":1,"parameters":["Pero todo comenzó aquí. Con un juramento. Con una daga. "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Con una X."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Historia de la Madera"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"San Jones y la Travesia de la Fruta"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[3,"Historia de la Mina Sombraluna"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[4,"Nacimientos Oficiales"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[5,"Cuentos para dormir de Altamar"]},{"code":0,"indent":1,"parameters":[]},{"code":403,"indent":0,"parameters":[6,null]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":12,"y":6},
