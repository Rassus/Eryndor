{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":102,"indent":0,"parameters":[["Sir Williams X - Capitulo 3","No"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Sir Williams X - Capitulo 3"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["\\{Capítulo III – Los Cuervos del Norte\\}"]},{"code":401,"indent":1,"parameters":["A los dieciocho, Sir William X fue enviado a su primera misión como "]},{"code":401,"indent":1,"parameters":["emisario de sombras. No recibió título. No vistió armadura. "]},{"code":401,"indent":1,"parameters":["Solo una capa gris sin escudo, una daga sin grabados, y una orden:"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["“Haz que se olviden.”"]},{"code":401,"indent":1,"parameters":["En el extremo norte del reino, más allá de los riscos helados, se "]},{"code":401,"indent":1,"parameters":["hallaba el Bastión Cuervo: una aldea-fortaleza de exiliados, hijos de "]},{"code":401,"indent":1,"parameters":["viejos nobles, mercenarios sin causa y hombres que alguna vez "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["juraron lealtad… y luego la retiraron."]},{"code":401,"indent":1,"parameters":["El Consejo del Reino no quería guerra. Quería silencio. Y para eso "]},{"code":401,"indent":1,"parameters":["enviaron a William."]},{"code":401,"indent":1,"parameters":["Llegó con el deshielo. Nadie lo vio entrar. Durante tres días, caminó "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["entre los refugiados, escuchando nombres, rutas de escape, tratos "]},{"code":401,"indent":1,"parameters":["con bandidos, nombres de reinos enemigos. Aprendía con los ojos. "]},{"code":401,"indent":1,"parameters":["Mataba con el tiempo."]},{"code":401,"indent":1,"parameters":["En la cuarta noche, ardió la torre de vigilancia."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["En la quinta, desapareció el líder rebelde."]},{"code":401,"indent":1,"parameters":["En la sexta, todos los perros murieron envenenados."]},{"code":401,"indent":1,"parameters":["En la séptima, los cuerpos comenzaron a colgar de los muros."]},{"code":401,"indent":1,"parameters":["Cuando el ejército del Reino llegó una semana después, no hubo "]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["batalla. Solo encontraron puertas abiertas, almacenes quemados, y "]},{"code":401,"indent":1,"parameters":["silencio."]},{"code":401,"indent":1,"parameters":["Solo una inscripción estaba grabada en una de las piedras "]},{"code":401,"indent":1,"parameters":["ennegrecidas del bastión:"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["“Nunca existimos.” — Los Cuervos"]},{"code":401,"indent":1,"parameters":["El mensaje no era para el Reino."]},{"code":401,"indent":1,"parameters":["Era para él."]},{"code":401,"indent":1,"parameters":["William no volvió al castillo en carroza ni fue recibido con honores."]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["Regresó a pie, cubierto de hollín y sangre seca, y entregó al consejero "]},{"code":401,"indent":1,"parameters":["sin rostro un saco con siete anillos sellados."]},{"code":401,"indent":1,"parameters":["No pidió oro. No pidió descanso."]},{"code":401,"indent":1,"parameters":["Solo preguntó:"]},{"code":101,"indent":1,"parameters":["",0,0,1]},{"code":401,"indent":1,"parameters":["— “¿Cuál es el siguiente nombre?”"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"No"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":2,"y":4}
